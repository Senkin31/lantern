# Copy to .env and adjust. .env is never committed.

# --- Lantern app (port 8000) ---
APP_DB=data/lantern.db
UPLOAD_DIR=data/uploads
# Camera config is owned by the vision side; the app only reads it.
CAMERAS_FILE=config/cameras.json
CAMERAS_FALLBACK=mock/cameras_mock.json
CONTRACTORS_FILE=config/contractors.json
# Served as /static so frame_url / crop_url from signals open
MOCK_DIR=mock

# Model service (Nikita, port 8001). Empty = built-in stub that always answers "accept".
ANALYZE_URL=
# ANALYZE_URL=http://127.0.0.1:8001/analyze
ANALYZE_TIMEOUT=10

# Clearing deadline: SNOWFALL_END + CLEARING_HOURS. The inspector can also press "Snowfall ended".
CLEARING_HOURS=6
SNOWFALL_END=
# Demo time compression: paste CLEARING_SECONDS printed by mock/send_signals.py
# (default speed: 1 scenario hour = 6 s -> CLEARING_SECONDS=36). Leave empty for real hours.
CLEARING_SECONDS=
# HOUR_SECONDS=6

MERGE_RADIUS_M=30
MERGE_WINDOW_HOURS=6
REOPEN_AFTER_HOURS=1
LOW_CONFIDENCE=0.5
NOTIFY_KPI_MINUTES=15

# Map tiles: OpenStreetMap on the demo, the city's own tiles (e.g. GeoRiga) later
TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
IMAGES_CREDIT=Images: Fintraffic / digitraffic.fi, CC BY 4.0
SOURCE_URL=https://github.com/Senkin31/lantern

# --- Spam protection (app/spam.py), real time ---
RATE_DEVICE_HOUR=6
RATE_DEVICE_DAY=20
RATE_IP_HOUR=30
AUTO_BLOCK_REJECTS=3
AUTO_BLOCK_DUPLICATES=5
AUTO_BLOCK_HOURS=24
SAME_PHOTO_DAYS=7
DHASH_DISTANCE=5
# lat_min,lon_min,lat_max,lon_max: reports outside are refused (default: Riga). Empty = no check.
SERVICE_AREA=56.85,23.90,57.10,24.35
# Callers that may send their own device_id (bot / replay on this machine). Everyone else gets a cookie id.
TRUSTED_HOSTS=127.0.0.1,::1
# Shared secret for a bot running on another host (sent as X-Lantern-Key). Set the same value for the bot.
INTERNAL_API_KEY=

# --- Telegram bot (app/bot) ---
# Create a bot with @BotFather and paste its token here.
TELEGRAM_BOT_TOKEN=
# 127.0.0.1, not localhost: on Windows "localhost" adds ~2 s per request (IPv6 fallback)
LANTERN_API_URL=http://127.0.0.1:8000
